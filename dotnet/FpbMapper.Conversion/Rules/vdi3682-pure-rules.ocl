-- FPD validation rule set — Phase 1 (PURE), executable by OCL.NET.
-- The 23 structural constraints that map directly to OCL over the FPD model AND
-- are executable against the CAEX serialization today (cardinalities, connection
-- typing, naming, reference resolution, semantics).
-- Informed by VDI 3682 Parts 1 and 2 plus tool-level conventions for the AML
-- serialization. This is an implementation profile, not a normative document.
-- Geometry (B) and schema-resolution (J) rules ship separately; see
-- vdi3682-helpers.ocl for the def: library. The four FPD_Characteristic rules
-- (E1/E2/E4/E5) live in vdi3682-phase2-rules.ocl until the binding exposes
-- characteristics as OCL instances — shipping them here would make them
-- silently-green dead rules.

context FPD_Project inv ProjectMinimumProcess:
  self.process->size() >= 1

context FPD_Process inv SystemLimitCardinality:
  -- at most one; exactly one once the process has begun (031, like FPB.js)
  self.containedElement->select(e | e.oclIsKindOf(FPD_SystemLimit))->size() <= 1 and (self.containedElement->select(e | e.oclIsKindOf(FPD_State) or e.oclIsKindOf(FPD_ProcessOperator) or e.oclIsKindOf(FPD_TechnicalResource))->notEmpty() implies self.containedElement->select(e | e.oclIsKindOf(FPD_SystemLimit))->size() = 1)

context FPD_Process inv StateMinimumCardinality:
  -- only for a process that has begun (031): an empty one is not started yet
  self.containedElement->select(e | e.oclIsKindOf(FPD_State) or e.oclIsKindOf(FPD_ProcessOperator) or e.oclIsKindOf(FPD_TechnicalResource))->notEmpty() implies self.containedElement->select(e | e.oclIsKindOf(FPD_State))->size() >= 2

context FPD_Process inv ProcessOperatorMinimumCardinality:
  self.containedElement->select(e | e.oclIsKindOf(FPD_State) or e.oclIsKindOf(FPD_ProcessOperator) or e.oclIsKindOf(FPD_TechnicalResource))->notEmpty() implies self.containedElement->select(e | e.oclIsKindOf(FPD_ProcessOperator))->size() >= 1

context FPD_Flow inv FlowEndpointsTyped:
  -- only between FPD elements (031): a link to an element outside any FPD
  -- (016f E4) starts at a flow interface but is a reference, not a flow
  (self.source.process->notEmpty() and self.target.process->notEmpty()) implies
  ((source.oclIsKindOf(FPD_State) and target.oclIsKindOf(FPD_ProcessOperator)) or
  (source.oclIsKindOf(FPD_ProcessOperator) and target.oclIsKindOf(FPD_State)))

context FPD_Flow inv NoStateToStateFlow:
  not (source.oclIsKindOf(FPD_State) and target.oclIsKindOf(FPD_State))

context FPD_Flow inv NoProcessOperatorToProcessOperatorFlow:
  not (source.oclIsKindOf(FPD_ProcessOperator) and target.oclIsKindOf(FPD_ProcessOperator))

context FPD_Usage inv UsageEndpointsTyped:
  (self.source.process->notEmpty() and self.target.process->notEmpty()) implies
  ((source.oclIsKindOf(FPD_ProcessOperator) and target.oclIsKindOf(FPD_TechnicalResource)) or
  (source.oclIsKindOf(FPD_TechnicalResource) and target.oclIsKindOf(FPD_ProcessOperator)))

context FPD_Process inv NoDuplicateConnections:
  self.connections->forAll(c1, c2 | (c1 <> c2 and c1.source = c2.source and c1.target = c2.target) implies c1.oclType() <> c2.oclType())

context FPD_Flow inv FlowDirected:
  self.sourceInterface.oclIsKindOf(FPD_FlowOut) and self.targetInterface.oclIsKindOf(FPD_FlowIn)

context FPD_ProcessOperator inv NoMixedFlowTypes:
  let outFlows = self.outgoingConnections->select(c | c.oclIsKindOf(FPD_Flow)) in outFlows->forAll(f1, f2 | f1.oclType() = f2.oclType())

context FPD_Object inv UniqueIdentifiers:
  -- per element (031): every element that shares its unique ID is reported,
  -- not the project; copies of a boundary state (refObj) are the same object
  ((self.oclIsKindOf(FPD_State) or self.oclIsKindOf(FPD_ProcessOperator) or self.oclIsKindOf(FPD_TechnicalResource)) and self.identification.uniqueIdent->notEmpty()) implies self.project.containedElement->select(e | e <> self and (e.oclIsKindOf(FPD_State) or e.oclIsKindOf(FPD_ProcessOperator) or e.oclIsKindOf(FPD_TechnicalResource)) and e.identification.uniqueIdent = self.identification.uniqueIdent and e.refObj <> self.identification.uniqueIdent and self.refObj <> e.identification.uniqueIdent)->isEmpty()

context FPD_Process inv ProcessNamed:
  self.name->notEmpty()

context FPD_Object inv LongNameMandatory:
  -- Name fallback: FPB.js populates shortName/name but leaves longName empty
  -- on every element; without the fallback this rule floods every model with
  -- one finding per element. D3 to D5 (operator, state, resource named) are
  -- the same condition and merged into this rule (031). Only states,
  -- operators and resources carry an identification (Blatt 2, 5.1), not the
  -- system limit the binding also counts as an object (031, corpus test).
  (self.oclIsKindOf(FPD_State) or self.oclIsKindOf(FPD_ProcessOperator) or self.oclIsKindOf(FPD_TechnicalResource)) implies ((self.identification.longName->notEmpty() and self.identification.longName.size() > 0) or (self.identification.shortName->notEmpty() and self.identification.shortName.size() > 0) or self.name->notEmpty())

context FPD_Object inv VersionRevisionPresent:
  (self.oclIsKindOf(FPD_State) or self.oclIsKindOf(FPD_ProcessOperator) or self.oclIsKindOf(FPD_TechnicalResource)) implies (self.identification.versionNumber->size() = 1 and self.identification.revisionNumber->size() = 1)

context FPD_Object inv RefObjResolvable:
  self.refObj->notEmpty() implies self.project.containedElement->exists(e | e.identification.uniqueIdent = self.refObj)

context FPD_ProcessOperator inv RefProcessResolvable:
  self.refProcess->notEmpty() implies self.project.process->exists(p | p.id = self.refProcess)

context FPD_Object inv AllReferencesResolvable:
  -- project.containedElement spans every instance hierarchy of the document. A
  -- reference resolves against an FPD uniqueIdent or, as an xs:IDREF, against the
  -- CAEX ID of any element, so a link into a non-FPD hierarchy (e.g. refBaseObj
  -- to a plant structure) is resolvable.
  Sequence{self.refObj, self.refBaseObj, self.refAspectObj, self.refDetailObj, self.refAbstractObj}->select(r | r->notEmpty())->forAll(r | self.project.containedElement->exists(e | e.identification.uniqueIdent = r or e.id = r))

context FPD_ProcessOperator inv ProcessOperatorHasIO:
  self.incomingConnections->select(c | c.oclIsKindOf(FPD_Flow))->size() >= 1 and self.outgoingConnections->select(c | c.oclIsKindOf(FPD_Flow))->size() >= 1

context FPD_State inv StateHasConcreteType:
  Sequence{FPD_Product, FPD_Energy, FPD_Information}->select(t | self.oclIsKindOf(t))->size() = 1

context FPD_Connection inv NoSelfReference:
  (self.source->notEmpty() and self.target->notEmpty()) implies self.source <> self.target

context FPD_Object inv NoOrphanedElements:
  (self.oclIsKindOf(FPD_State) or self.oclIsKindOf(FPD_ProcessOperator) or self.oclIsKindOf(FPD_TechnicalResource)) implies (self.incomingConnections->notEmpty() or self.outgoingConnections->notEmpty())

context FPD_Connection inv SourceTargetSameProcess:
  -- only between FPD elements (031): a link to an element outside any FPD
  -- (a plant structure, 016f E4) is a reference, not a flow
  (self.source->notEmpty() and self.target->notEmpty() and self.source.process->notEmpty() and self.target.process->notEmpty()) implies self.source.process = self.target.process
